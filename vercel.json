{
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    },
    {
      "source": "/private-inquiry",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/assets/the-royal-velvet-sub-logo-bgless.png",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noimageindex"
        }
      ]
    },
    {
      "source": "/assets/the-royal-velvet-sub-logo-web.png",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noimageindex"
        }
      ]
    },
    {
      "source": "/assets/royal-velvet-homepage-title.png",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noimageindex"
        }
      ]
    },
    {
      "source": "/assets/effortlessly-lavish-lettering.png",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noimageindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/our-story",
      "destination": "/our-story/index.html"
    },
    {
      "source": "/events",
      "destination": "/events/index.html"
    },
    {
      "source": "/wedding-planning",
      "destination": "/wedding-planning/index.html"
    },
    {
      "source": "/destination-weddings",
      "destination": "/destination-weddings/index.html"
    },
    {
      "source": "/corporate-events",
      "destination": "/corporate-events/index.html"
    },
    {
      "source": "/packages",
      "destination": "/packages/index.html"
    },
    {
      "source": "/venues",
      "destination": "/venues/index.html"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery/index.html"
    },
    {
      "source": "/artists-and-talent",
      "destination": "/artists-and-talent/index.html"
    },
    {
      "source": "/legacy",
      "destination": "/legacy/index.html"
    },
    {
      "source": "/careers",
      "destination": "/careers/index.html"
    },
    {
      "source": "/book-consultation",
      "destination": "/book-consultation/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/private-inquiry",
      "destination": "/book-consultation/index.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/projects/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.royalvelveteventz.com"
        }
      ],
      "destination": "https://the-royalvelvet.com/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "royalvelveteventz.com"
        }
      ],
      "destination": "https://the-royalvelvet.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.royalvelveteventz.com"
        }
      ],
      "destination": "https://the-royalvelvet.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "royalvelveteventz.com"
        }
      ],
      "destination": "https://the-royalvelvet.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.the-royalvelvet.com"
        }
      ],
      "destination": "https://the-royalvelvet.com/:path*",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/our-story",
      "permanent": true
    },
    {
      "source": "/artists",
      "destination": "/artists-and-talent",
      "permanent": true
    },
    {
      "source": "/milestone",
      "destination": "/legacy",
      "permanent": true
    },
    {
      "source": "/booking",
      "destination": "/book-consultation",
      "permanent": true
    }
  ]
}
